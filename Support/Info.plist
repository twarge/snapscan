<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>SnapScan</string>
	<key>CFBundleDisplayName</key>
	<string>SnapScan</string>
	<key>CFBundleIdentifier</key>
	<string>com.twarge.snapscan</string>
	<key>CFBundleExecutable</key>
	<string>SnapScan</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Taken from the build settings so CI can stamp each upload: the
	     release workflow passes CURRENT_PROJECT_VERSION from the run number,
	     which App Store Connect requires to increase every time. -->
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>LSMinimumSystemVersion</key>
	<string>15.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 Tom Kornack. Licensed under Apache-2.0.</string>
</dict>
</plist>
